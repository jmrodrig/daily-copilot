# Copy to `.env` (git-ignored) and fill in values. Every setting can also be
# provided as a system environment variable with the COPILOT_ prefix.

# SQLite database file. Relative paths resolve against the backend/ directory.
COPILOT_DB_PATH=copilot.db

# Root folder of the markdown notes (wiki, emails). Relative paths resolve
# against the backend/ directory.
COPILOT_NOTES_DIR=notes

# Bind address. Keep 127.0.0.1 for local dev; bind to the machine's Tailscale
# IP (100.x.y.z) to expose the API to the Android app over the tailnet only.
COPILOT_HOST=127.0.0.1
COPILOT_PORT=8000

# Model endpoints
COPILOT_OLLAMA_BASE_URL=http://localhost:11434
# litellm model used by the Gantt PDF parser (requires COPILOT_GEMINI_API_KEY)
COPILOT_GANTT_MODEL=gemini/gemini-3.1-pro-preview
# litellm model behind the Co-pilot chat agent (requires COPILOT_GEMINI_API_KEY)
COPILOT_CHAT_MODEL=gemini/gemini-3.1-pro-preview

# API keys (never commit real values)
COPILOT_GEMINI_API_KEY=
COPILOT_ANTHROPIC_API_KEY=
